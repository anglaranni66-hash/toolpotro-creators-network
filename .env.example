# Toolpotro Creators Network Environment Configuration
# Set all private keys in Render Dashboard -> Environment Variables (never commit secrets)

# GEMINI_API_KEY: Required for Gemini AI Audio & Caption Verification
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Single balanced cost-efficient model (default: gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-3.1-flash-lite"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 Key for live Shorts/Video views & descriptions
YOUTUBE_API_KEY=""

# APIFY_API_TOKEN: Apify token for automated Facebook, Instagram, and TikTok views, comments & media URLs
APIFY_API_TOKEN=""

# APP_URL: Deployment host URL
APP_URL="https://creators.toolpotro.com"

# PORT: Server listening port (defaults to 3000 locally, Render defaults to 10000)
PORT=3000

# NODE_ENV: development | production
NODE_ENV="development"

# FIREBASE CONFIG
FIREBASE_PROJECT_ID="toolpotro-creators-network"
